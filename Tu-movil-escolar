<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Balance de Viajes - Transporte Escolar</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-100 min-h-screen p-4 sm:p-8">
    <div class="max-w-4xl mx-auto bg-white shadow-lg rounded-xl p-6 sm:p-8">
        <header class="border-b pb-4 mb-6">
            <!-- Título Editable -->
            <input type="text" id="tituloMovil" value="Mi Transporte Escolar" 
                onblur="guardarTitulo()"
                class="text-2xl font-bold text-slate-800 w-full border-none focus:ring-0 focus:outline-none bg-transparent hover:bg-slate-50 cursor-pointer p-1">
            <p class="text-sm text-slate-500">Control de asistencia diaria y cobros. (Haz clic en el título para editarlo)</p>
        </header>

        <!-- Configuración de Tarifa -->
        <div class="bg-indigo-50 p-4 rounded-lg mb-6 flex flex-col sm:flex-row items-center justify-between gap-4">
            <div>
                <label for="tarifaDiaria" class="block text-sm font-medium text-indigo-900">Valor del viaje diario por alumno ($):</label>
                <input type="number" id="tarifaDiaria" value="1000" min="0" class="mt-1 block w-full sm:w-48 rounded-md border-slate-300 shadow-sm p-2 border focus:ring-indigo-500 focus:border-indigo-500">
            </div>
            <button onclick="guardarTarifa()" class="w-full sm:w-auto bg-indigo-600 text-white px-4 py-2 rounded-lg font-medium hover:bg-indigo-700 transition">Actualizar Tarifa</button>
        </div>

        <!-- Formulario Agregar Alumno -->
        <form id="formAlumno" onsubmit="agregarAlumno(event)" class="mb-8 flex flex-col sm:flex-row gap-3">
            <input type="text" id="nombreAlumno" placeholder="Nombre y Apellido del alumno" required class="flex-1 rounded-md border-slate-300 shadow-sm p-3 border focus:ring-indigo-500 focus:border-indigo-500">
            <button type="submit" class="bg-emerald-600 text-white px-6 py-3 rounded-lg font-medium hover:bg-emerald-700 transition">Agregar Alumno</button>
        </form>

        <!-- Listado y Balance -->
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-slate-200">
                <thead class="bg-slate-50">
                    <tr>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">Alumno</th>
                        <th class="px-4 py-3 text-center text-xs font-semibold text-slate-600 uppercase tracking-wider">Lun</th>
                        <th class="px-4 py-3 text-center text-xs font-semibold text-slate-600 uppercase tracking-wider">Mar</th>
                        <th class="px-4 py-3 text-center text-xs font-semibold text-slate-600 uppercase tracking-wider">Mié</th>
                        <th class="px-4 py-3 text-center text-xs font-semibold text-slate-600 uppercase tracking-wider">Jue</th>
                        <th class="px-4 py-3 text-center text-xs font-semibold text-slate-600 uppercase tracking-wider">Vie</th>
                        <th class="px-4 py-3 text-center text-xs font-semibold text-slate-600 uppercase tracking-wider">Total</th>
                        <th class="px-4 py-3 text-right text-xs font-semibold text-slate-600 uppercase tracking-wider">Subtotal ($)</th>
                        <th class="px-4 py-3 text-center text-xs font-semibold text-slate-600 uppercase tracking-wider">Acciones</th>
                    </tr>
                </thead>
                <tbody id="tablaAlumnos" class="bg-white divide-y divide-slate-200">
                    <!-- Los alumnos se cargan dinámicamente -->
                </tbody>
            </table>
        </div>

        <!-- Resumen Total -->
        <div class="mt-8 bg-slate-50 p-6 rounded-xl flex flex-col sm:flex-row justify-between items-center border border-slate-200">
            <div>
                <p class="text-sm text-slate-500">Total de alumnos activos: <span id="totalAlumnos" class="font-bold text-slate-800">0</span></p>
            </div>
            <div class="text-right">
                <p class="text-sm text-slate-500">Total recaudado:</p>
                <div class="text-2xl font-bold text-emerald-600" id="montoTotalGeneral">$0</div>
            </div>
        </div>
    </div>

    <script>
        let alumnos = JSON.parse(localStorage.getItem('viajes_alumnos')) || [];
        let tarifa = parseFloat(localStorage.getItem('viajes_tarifa')) || 1000;
        let titulo = localStorage.getItem('viajes_titulo') || "Mi Transporte Escolar";

        // Inicializar valores
        document.getElementById('tarifaDiaria').value = tarifa;
        document.getElementById('tituloMovil').value = titulo;

        function guardarTitulo() {
            titulo = document.getElementById('tituloMovil').value;
            localStorage.setItem('viajes_titulo', titulo);
        }

        function guardarTarifa() {
            tarifa = parseFloat(document.getElementById('tarifaDiaria').value) || 0;
            localStorage.setItem('viajes_tarifa', tarifa);
            renderizarTabla();
        }

        function agregarAlumno(e) {
            e.preventDefault();
            const input = document.getElementById('nombreAlumno');
            const nombre = input.value.trim();
            if (!nombre) return;

            alumnos.push({ id: Date.now(), nombre: nombre, dias: [false, false, false, false, false] });
            input.value = '';
            guardarYRenderizar();
        }

        function eliminarAlumno(id) {
            if (confirm('¿Eliminar alumno de la lista?')) {
                alumnos = alumnos.filter(a => a.id !== id);
                guardarYRenderizar();
            }
        }

        function toggleDia(id, diaIndex) {
            const alumno = alumnos.find(a => a.id === id);
            if (alumno) {
                alumno.dias[diaIndex] = !alumno.dias[diaIndex];
                guardarYRenderizar();
            }
        }

        function guardarYRenderizar() {
            localStorage.setItem('viajes_alumnos', JSON.stringify(alumnos));
            renderizarTabla();
        }

        function renderizarTabla() {
            const tbody = document.getElementById('tablaAlumnos');
            tbody.innerHTML = '';
            let granTotalRecaudado = 0;

            alumnos.forEach(alumno => {
                const tr = document.createElement('tr');
                const viajesTotales = alumno.dias.filter(Boolean).length;
                const subtotal = viajesTotales * tarifa;
                granTotalRecaudado += subtotal;

                let htmlDias = alumno.dias.map((asistio, index) => `
                    <td class="px-4 py-3 text-center">
                        <input type="checkbox" ${asistio ? 'checked' : ''} onchange="toggleDia(${alumno.id}, ${index})" class="w-5 h-5 cursor-pointer">
                    </td>
                `).join('');

                tr.innerHTML = `
                    <td class="px-4 py-3 text-sm font-medium text-slate-800">${alumno.nombre}</td>
                    ${htmlDias}
                    <td class="px-4 py-3 text-center text-sm font-semibold">${viajesTotales}</td>
                    <td class="px-4 py-3 text-right text-sm font-bold">$${subtotal.toLocaleString()}</td>
                    <td class="px-4 py-3 text-center"><button onclick="eliminarAlumno(${alumno.id})" class="text-rose-600 font-bold">X</button></td>
                `;
                tbody.appendChild(tr);
            });

            document.getElementById('totalAlumnos').textContent = alumnos.length;
            document.getElementById('montoTotalGeneral').textContent = `$${granTotalRecaudado.toLocaleString()}`;
        }

        renderizarTabla();
    </script>
</body>
</html>

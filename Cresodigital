    function sendOrder() {
      const entries = Object.values(cart);
      if (!entries.length) { showToast("Agregá algún producto primero", "🛒"); return; }

      const nombre = document.getElementById("clienteNombre").value.trim();
      const tel = document.getElementById("clienteTel").value.trim();
      const entrega = document.getElementById("clienteEntrega").value;
      const pago = document.getElementById("clientePago").value;
      const dir = document.getElementById("clienteDireccion").value.trim();
      const notas = document.getElementById("clienteNotas").value.trim();

      if (!nombre || !tel) { showToast("Completá nombre y teléfono", "⚠️"); return; }
      if (entrega === "Envío a coordinar" && !dir) { showToast("Completá dirección o zona", "📍"); return; }

      playAddSound();
      let total = 0;
      const mixActive = isWholesaleActiveForCart();
      let msg = `*PEDIDO CRESO*\n👤 *Cliente:* ${nombre}\n📱 *Tel:* ${tel}\n🚚 *Entrega:* ${entrega}\n`;
      if (entrega === "Envío a coordinar") msg += `📍 *Dirección:* ${dir}\n`;
      msg += `💳 *Pago:* ${pago}\n\n*DETALLE:*\n`;

      entries.forEach(e => {
        const p = state.products.find(x => x.id === e.id);
        if (!p) return;
        const minMay = p.minMayorista || MIXED_WHOLESALE_MIN;
        const isMayItem = mixActive || e.cantidad >= minMay;
        const uPrice = getEffectiveUnitPrice(p, e.cantidad);
        const sub = uPrice * e.cantidad;
        total += sub;
        msg += `• ${e.cantidad}x ${p.nombre}${isMayItem ? " [Mayorista]" : ""} — $${sub.toLocaleString("es-AR")}\n`;
      });

      msg += `\n💰 *Total (${pago}): $${total.toLocaleString("es-AR")}*`;
      if (notas) msg += `\n📝 *Notas:* ${notas}`;

      const phone = state.whatsapp.replace(/\D/g, "") || "5491133667793";
      window.open(`https://wa.me/${phone}?text=${encodeURIComponent(msg)}`, "_blank");
    }

    function closeAdminDrawer() {
      document.getElementById("adminDrawerOverlay").classList.remove("active");
    }

    function toggleAdmin() {
      const ov = document.getElementById("adminDrawerOverlay");
      if (ov.classList.contains("active")) {
        closeAdminDrawer();
        return;
      }
      if (!adminUnlocked) {
        const pass = prompt("Ingresá la contraseña de administrador de CRESO:");
        if (pass === null) return;
        if (pass.trim() !== ADMIN_PASS) {
          showToast("Contraseña incorrecta", "🔒");
          return;
        }
        adminUnlocked = true;
      }
      ov.classList.add("active");
      renderAdmin();
    }

    function renderAdmin() {
      document.getElementById("adminWhatsapp").value = state.whatsapp;
      document.getElementById("adminProductsList").innerHTML = state.products.map((p, i) => `
        <div class="admin-item">
          <div class="admin-field" style="margin-top:0;">
            <label>Nombre del producto</label>
            <input type="text" value="${escapeAttr(p.nombre)}" onchange="updateField(${i}, 'nombre', this.value)">
          </div>
          <div class="admin-field">
            <label>Descripción</label>
            <input type="text" value="${escapeAttr(p.desc)}" onchange="updateField(${i}, 'desc', this.value)">
          </div>
          <div class="admin-field">
            <label>Link de foto (URL directa)</label>
            <input type="text" value="${escapeAttr(p.customImg || "")}" placeholder="https://..." onchange="updateImgUrl(${i}, this.value)">
          </div>
          <div class="admin-prices">
            <div>
              <label>Precio unidad</label>
              <input type="number" value="${p.precioUnitario}" onchange="updatePrice(${i}, 'precioUnitario', this.value)">
            </div>
            <div>
              <label>Precio 3+ u. (c/u)</label>
              <input type="number" value="${p.precioMayorista}" onchange="updatePrice(${i}, 'precioMayorista', this.value)">
            </div>
            <label class="btn-photo">📷 Foto<input type="file" accept="image/*" style="display:none;" onchange="uploadPhoto(${i}, this)"></label>
          </div>
        </div>
      `).join("");
    }

    function updateField(i, field, val) {
      state.products[i][field] = val.trim();
      persistState();
      renderProducts();
      updateCartUI();
      playClickSound();
    }

    function updateImgUrl(i, val) {
      state.products[i].customImg = val.trim();
      persistState();
      renderProducts();
      updateCartUI();
      playClickSound();
    }

    function saveSettings() {
      state.whatsapp = document.getElementById("adminWhatsapp").value.trim() || state.whatsapp;
      persistState();
      playClickSound();
      showToast("WhatsApp guardado", "✅");
    }

    function updatePrice(i, field, val) {
      const n = parseInt(val, 10);
      if (!isNaN(n) && n >= 0) {
        state.products[i][field] = n;
        persistState();
        renderProducts();
        updateCartUI();
        playClickSound();
      }
    }

    function uploadPhoto(i, input) {
      const file = input.files && input.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = e => {
        const img = new Image();
        img.onload = () => {
          const canvas = document.createElement("canvas");
          const max = 640;
          let w = img.width, h = img.height;
          if (w > max || h > max) {
            if (w > h) { h = Math.round(h * max / w); w = max; }
            else { w = Math.round(w * max / h); h = max; }
          }
          canvas.width = w; canvas.height = h;
          canvas.getContext("2d").drawImage(img, 0, 0, w, h);
          state.products[i].customImg = canvas.toDataURL("image/jpeg", 0.82);
          persistState();
          renderProducts();
          updateCartUI();
          renderAdmin();
          playAddSound();
          showToast("Foto guardada en CRESO", "📷");
        };
        img.src = e.target.result;
      };
      reader.readAsDataURL(file);
    }

    function exportStandaloneHTML() {
      const wasAdminOpen = document.getElementById("adminDrawerOverlay").classList.contains("active");
      const wasCartOpen = document.getElementById("cartDrawerOverlay").classList.contains("active");
      closeAdminDrawer();
      document.getElementById("cartDrawerOverlay").classList.remove("active");

      let html = document.documentElement.outerHTML;
      html = html.replace(/const DEFAULT_PRODUCTS = \[[\s\S]*?\];/, `const DEFAULT_PRODUCTS = ${JSON.stringify(state.products, null, 6)};`);
      html = html.replace(/whatsapp:\s*"[^"]*"/, `whatsapp: "${state.whatsapp.replace(/"/g, "")}"`);

      if (wasAdminOpen) document.getElementById("adminDrawerOverlay").classList.add("active");
      if (wasCartOpen) document.getElementById("cartDrawerOverlay").classList.add("active");

      const blob = new Blob(["<!DOCTYPE html>\n" + html], { type: "text/html;charset=utf-8" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = "index.html";
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
      showToast("index.html descargado (con panel cerrado)", "💾");
    }

    // Inicializar catálogo y carrito al cargar
    renderProducts();
    updateCartUI();
  </script>
</body>
</html>

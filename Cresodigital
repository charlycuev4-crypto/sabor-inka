      document.querySelectorAll(".tab").forEach(tab => tab.classList.remove("active"));
      if (el) el.classList.add("active");
      renderProducts();
    }

    function getTotalCartUnits() {
      return Object.values(cart).reduce((sum, item) => sum + (item.cantidad || 0), 0);
    }

    /* 3+ unidades sumando cualquier producto del carrito aplica precio mayorista */
    function isWholesaleActiveForCart() {
      return getTotalCartUnits() >= MIXED_WHOLESALE_MIN;
    }

    function getEffectiveUnitPrice(p, qty) {
      const minMay = p.minMayorista || MIXED_WHOLESALE_MIN;
      if (qty >= minMay || isWholesaleActiveForCart()) {
        return p.precioMayorista;
      }
      return p.precioUnitario;
    }

    function escapeAttr(val) {
      return String(val || "").replace(/&/g, "&amp;").replace(/"/g, "&quot;").replace(/</g, "&lt;");
    }

    function getProductVisual(p) {
      const cleanUrl = (p.customImg || "").trim();
      if (cleanUrl) {
        return `<img src="${escapeAttr(cleanUrl)}" alt="${escapeAttr(p.nombre)}" loading="eager">`;
      }
      return SVG_ICONS[p.svgKey] || SVG_ICONS.cable;
    }

    function renderProducts() {
      const q = document.getElementById("searchInput").value.trim().toLowerCase();
      const sort = document.getElementById("sortSelect").value;
      const grid = document.getElementById("productsGrid");
      const totalUnits = getTotalCartUnits();
      const wholesaleMixActive = totalUnits >= MIXED_WHOLESALE_MIN;

      let list = state.products.filter(p => {
        const matchCat = currentCategory === "todos" || p.categoria === currentCategory;
        const matchQ = !q || p.nombre.toLowerCase().includes(q) || p.desc.toLowerCase().includes(q);
        return matchCat && matchQ;
      });

      if (sort === "price-asc") list.sort((a, b) => a.precioUnitario - b.precioUnitario);
      if (sort === "price-desc") list.sort((a, b) => b.precioUnitario - a.precioUnitario);

      if (!list.length) {
        grid.innerHTML = `<div style="grid-column:1/-1; text-align:center; padding:40px 16px; color:var(--text-secondary);">Sin resultados para "${escapeAttr(q)}".</div>`;
        return;
      }

      grid.innerHTML = list.map(p => {
        const minMay = p.minMayorista || MIXED_WHOLESALE_MIN;
        const qty = cart[p.id] ? cart[p.id].cantidad : 0;
        const rem = Math.max(0, MIXED_WHOLESALE_MIN - totalUnits);
        const pct = Math.min(100, (totalUnits / MIXED_WHOLESALE_MIN) * 100);
        const unlocked = wholesaleMixActive || qty >= minMay;
        const shownPrice = unlocked ? p.precioMayorista : p.precioUnitario;

        let statusLeft = `Mayorista ${MIXED_WHOLESALE_MIN}+ u. (cualquier mezcla)`;
        if (unlocked) {
          statusLeft = qty > 0 ? `✓ Mayorista activo (${qty} u.)` : "✓ Mayorista activo en tu pedido";
        } else if (totalUnits > 0) {
          statusLeft = `${totalUnits} u. en pedido (${qty} de este)`;
        }

        return `
        <article class="card" id="card-${p.id}">
          ${p.badge ? `<span class="badge ${p.goldBadge ? "gold-badge" : ""}">${p.badge}</span>` : ""}
          <div class="card-visual">${getProductVisual(p)}</div>
          <div class="card-body">
            <span class="card-cat">${p.categoria}</span>
            <h3 class="card-title">${p.nombre}</h3>
            <p class="card-desc">${p.desc}</p>
            <div class="price-row">
              <span class="price-main">$${shownPrice.toLocaleString("es-AR")}</span>
              <span class="price-wholesale">${minMay}+: $${p.precioMayorista.toLocaleString("es-AR")}</span>
            </div>
            <div class="progress-mini">
              <div class="progress-label ${unlocked ? "done" : ""}">
                <span>${statusLeft}</span>
                <span>${unlocked ? "" : `Faltan ${rem}`}</span>
              </div>
              <div class="bar-bg"><div class="bar-fill" style="width:${pct}%"></div></div>
            </div>
            <div class="card-actions">
              <button class="btn-add" id="btn-${p.id}" onclick="addToCart('${p.id}', 1)">➕ Agregar</button>
              <button class="btn-pack" onclick="addToCart('${p.id}', ${minMay})">+${minMay}</button>
            </div>
          </div>
        </article>`;
      }).join("");
    }

    function addToCart(id, qty) {
      const p = state.products.find(item => item.id === id);
      if (!p) return;
      cart[id] = cart[id] ? { id, cantidad: cart[id].cantidad + qty } : { id, cantidad: qty };
      playAddSound();

      const card = document.getElementById(`card-${id}`);
      if (card) { card.classList.remove("added-anim"); void card.offsetWidth; card.classList.add("added-anim"); }

      const btn = document.getElementById(`btn-${id}`);
      if (btn && qty === 1) {
        btn.textContent = "✓ Sumado";
        btn.classList.add("added");
        setTimeout(() => { btn.textContent = "➕ Agregar"; btn.classList.remove("added"); }, 1000);
      }

      const totalUnits = getTotalCartUnits();
      if (totalUnits >= MIXED_WHOLESALE_MIN) {
        showToast(`¡${totalUnits} unidades en total: precio mayorista activo!`, "💰");
      } else {
        const faltan = MIXED_WHOLESALE_MIN - totalUnits;
        showToast(`¡${p.nombre} agregado! Sumá ${faltan} más para mayorista`, "🛒");
      }

      animateFab();
      renderProducts();
      updateCartUI();
    }

    function animateFab() {
      const fab = document.getElementById("cartFab");
      const badge = document.getElementById("cartFabBadge");
      fab.classList.remove("bounce"); void fab.offsetWidth; fab.classList.add("bounce");
      badge.classList.remove("pop"); void badge.offsetWidth; badge.classList.add("pop");
    }

    function updateQty(id, delta) {
      if (!cart[id]) return;
      playClickSound();
      cart[id].cantidad += delta;
      if (cart[id].cantidad <= 0) delete cart[id];
      renderProducts();
      updateCartUI();
    }

    function updateCartUI() {
      const entries = Object.values(cart);
      const container = document.getElementById("cartItems");
      if (!entries.length) {
        container.innerHTML = `<div style="text-align:center; padding:28px 12px; color:var(--text-secondary);">Tu carrito está vacío. Agregá productos para armar tu pedido.</div>`;
        document.getElementById("savingsContainer").innerHTML = "";
        document.getElementById("cartFabBadge").textContent = "0";
        document.getElementById("cartFabTotal").textContent = "$0";
        document.getElementById("totalPrice").textContent = "Total: $0";
        return;
      }

      let units = 0, regularSum = 0, finalSum = 0;
      const mixActive = isWholesaleActiveForCart();

      container.innerHTML = entries.map(e => {
        const p = state.products.find(x => x.id === e.id);
        if (!p) return "";
        const minMay = p.minMayorista || MIXED_WHOLESALE_MIN;
        const isMayItem = mixActive || e.cantidad >= minMay;
        const unitP = getEffectiveUnitPrice(p, e.cantidad);
        const sub = unitP * e.cantidad;
        units += e.cantidad;
        regularSum += p.precioUnitario * e.cantidad;
        finalSum += sub;

        return `
        <div class="cart-item">
          <div class="cart-item-left">
            <div class="cart-item-thumb">${getProductVisual(p)}</div>
            <div class="cart-item-info">
              <h4>${p.nombre}</h4>
              <div class="cart-item-meta">$${unitP.toLocaleString("es-AR")} c/u ${isMayItem ? "• MAYORISTA" : ""}</div>
            </div>
          </div>
          <div class="qty-controls">
            <button class="qty-btn" onclick="updateQty('${p.id}', -1)">−</button>
            <span>${e.cantidad}</span>
            <button class="qty-btn" onclick="updateQty('${p.id}', 1)">+</button>
          </div>
          <strong style="min-width:74px; text-align:right; font-size:0.9rem;">$${sub.toLocaleString("es-AR")}</strong>
        </div>`;
      }).join("");

      const saved = regularSum - finalSum;
      if (mixActive && saved > 0) {
        document.getElementById("savingsContainer").innerHTML = `<div class="savings-banner">🎉 Mayorista activo por llevar ${units} unidades (ahorrás $${saved.toLocaleString("es-AR")})</div>`;
      } else if (mixActive) {
        document.getElementById("savingsContainer").innerHTML = `<div class="savings-banner">✓ Mayorista activo por llevar ${units} unidades en total</div>`;
      } else {
        const faltan = MIXED_WHOLESALE_MIN - units;
        document.getElementById("savingsContainer").innerHTML = `<div class="savings-banner">💡 Sumá ${faltan} ${faltan === 1 ? "unidad más" : "unidades más"} (de cualquier producto) para activar precio mayorista</div>`;
      }

      document.getElementById("cartFabBadge").textContent = units;
      document.getElementById("cartFabTotal").textContent = `$${finalSum.toLocaleString("es-AR")}`;
      document.getElementById("totalPrice").textContent = `Total: $${finalSum.toLocaleString("es-AR")}`;
    }

    function toggleCart() { document.getElementById("cartDrawerOverlay").classList.toggle("active"); }

    function toggleDireccionField() {
      const v = document.getElementById("clienteEntrega").value;
